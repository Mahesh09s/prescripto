# Prescripto Frontend — Environment Variables Template
# Copy to .env and fill in your values. Never commit .env to git.

# ─── API URL ──────────────────────────────────────────────────────────────────
# In development: leave blank — Vite proxy routes /api → http://localhost:5000
# In production: set to your Render backend URL (no trailing slash, include /api)
# Example: https://prescripto-backend.onrender.com/api
VITE_API_URL=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Must match GOOGLE_CLIENT_ID in backend/.env
# Required for "Continue with Google" sign-in on the login page
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
