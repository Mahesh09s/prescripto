{
  "info": {
    "_postman_id": "prescripto-api-v1",
    "name": "Prescripto API",
    "description": "Complete REST API collection for Prescripto — Doctor Appointment Booking System.\n\nBase URL: http://localhost:5000\n\nAuth: Bearer token (JWT). After login/register, copy the `token` from the response and set it as a variable.\n\nCollection Variables:\n- `baseUrl` → http://localhost:5000\n- `doctorToken` → (paste from doctor login response)\n- `patientToken` → (paste from patient login response)\n- `doctorId` → (paste a doctor's _id)\n- `appointmentId` → (paste an appointment's _id)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "patientToken", "value": "" },
    { "key": "doctorToken", "value": "" },
    { "key": "doctorId", "value": "" },
    { "key": "appointmentId", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "GET / — Server Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/",
            "description": "Returns server status, version, and all available routes."
          }
        }
      ]
    },
    {
      "name": "Doctor Auth",
      "item": [
        {
          "name": "POST /api/doctors/register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/doctors/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Jane Smith\",\n  \"email\": \"jane.smith@example.com\",\n  \"password\": \"securepass123\",\n  \"speciality\": \"Dermatologist\",\n  \"address\": {\n    \"street\": \"123 Medical Ave\",\n    \"city\": \"Mumbai\",\n    \"state\": \"Maharashtra\",\n    \"pincode\": \"400001\"\n  }\n}"
            },
            "description": "Register a new doctor account. Rate limited to 10 requests per 15 minutes."
          }
        },
        {
          "name": "POST /api/doctors/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "if(data.token) { pm.collectionVariables.set('doctorToken', data.token); }",
                  "if(data.doctor) { pm.collectionVariables.set('doctorId', data.doctor._id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/doctors/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.smith@example.com\",\n  \"password\": \"securepass123\"\n}"
            },
            "description": "Login as doctor. Auto-saves token + doctorId to collection variables."
          }
        }
      ]
    },
    {
      "name": "Patient Auth",
      "item": [
        {
          "name": "POST /api/patients/register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/patients/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"mypassword123\",\n  \"phone\": \"+91 9876543210\"\n}"
            },
            "description": "Register a new patient account."
          }
        },
        {
          "name": "POST /api/patients/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "if(data.token) { pm.collectionVariables.set('patientToken', data.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/patients/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"mypassword123\"\n}"
            },
            "description": "Login as patient. Auto-saves patientToken to collection variables."
          }
        }
      ]
    },
    {
      "name": "Doctors",
      "item": [
        {
          "name": "GET /api/doctors — List All Doctors",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/doctors",
            "description": "Public. Returns all available doctors (excludes password and slots_booked)."
          }
        },
        {
          "name": "GET /api/doctors/:id — Get Doctor by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/doctors/{{doctorId}}",
            "description": "Public. Returns a single doctor's full profile (excludes password)."
          }
        },
        {
          "name": "GET /api/doctors/:id/slots — Get Available Slots",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/doctors/{{doctorId}}/slots?date=2026-06-15",
              "query": [{ "key": "date", "value": "2026-06-15", "description": "Required. Format: YYYY-MM-DD" }]
            },
            "description": "Public. Returns available time slots for a doctor on a given date."
          }
        },
        {
          "name": "PUT /api/doctors/profile — Update Profile [Doctor]",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/doctors/profile",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"about\": \"Specialist in skin care with 8 years experience.\",\n  \"fees\": 800,\n  \"available\": true\n}"
            },
            "description": "Protected (doctor JWT). Update your own doctor profile. Only whitelisted fields accepted."
          }
        },
        {
          "name": "PUT /api/doctors/availability — Toggle Availability [Doctor]",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/doctors/availability",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"available\": false\n}"
            },
            "description": "Protected (doctor JWT). Toggle your availability status."
          }
        }
      ]
    },
    {
      "name": "Patients",
      "item": [
        {
          "name": "GET /api/patients/profile [Patient]",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/patients/profile",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "description": "Protected (patient JWT). Returns the authenticated patient's profile."
          }
        },
        {
          "name": "PUT /api/patients/profile — Update Profile [Patient]",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/patients/profile",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+91 9876543211\",\n  \"gender\": \"Male\",\n  \"dob\": \"1995-03-15\",\n  \"address\": {\n    \"line1\": \"42 Elm Street\",\n    \"line2\": \"Andheri West, Mumbai\"\n  }\n}"
            },
            "description": "Protected (patient JWT). Update patient profile. Only whitelisted fields accepted."
          }
        }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "POST /api/appointments/book [Patient]",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "if(data.appointment) { pm.collectionVariables.set('appointmentId', data.appointment._id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/appointments/book",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"date\": \"2026-06-15\",\n  \"slot\": \"10:00-10:20\",\n  \"reason\": \"Skin rash for 2 weeks\"\n}"
            },
            "description": "Protected (patient JWT). Book an appointment. Duplicate slot + doctor + date combination will return 409."
          }
        },
        {
          "name": "GET /api/appointments/my [Patient]",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/appointments/my",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "description": "Protected (patient JWT). Returns all appointments for the authenticated patient."
          }
        },
        {
          "name": "GET /api/appointments/doctor [Doctor]",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/appointments/doctor",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }],
            "description": "Protected (doctor JWT). Returns all appointments for the authenticated doctor."
          }
        },
        {
          "name": "PUT /api/appointments/cancel/:id [Patient or Doctor]",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/appointments/cancel/{{appointmentId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "description": "Protected (patient or doctor JWT). Cancels an appointment. Authorization checked inside controller."
          }
        },
        {
          "name": "PUT /api/appointments/complete/:id [Doctor]",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/appointments/complete/{{appointmentId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }],
            "description": "Protected (doctor JWT). Marks an appointment as completed."
          }
        }
      ]
    },
    {
      "name": "Error Cases",
      "item": [
        {
          "name": "404 — Unknown Route",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/unknown-route",
            "description": "Returns {success: false, message: 'Route not found'}"
          }
        },
        {
          "name": "401 — No Token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/patients/profile",
            "description": "Returns 401 {success: false, message: 'No token provided'}"
          }
        },
        {
          "name": "429 — Rate Limit (Auth)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/patients/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@test.com\",\n  \"password\": \"wrong\"\n}"
            },
            "description": "Hit 10+ times in 15 minutes to trigger 429 rate limit response."
          }
        }
      ]
    }
  ]
}
