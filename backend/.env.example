# Prescripto Backend — Environment Variables Template
# Copy to .env and fill in your values. Never commit .env to git.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/prescripto?retryWrites=true&w=majority&appName=prescripto

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_long_random_secret_at_least_32_chars

# ─── CORS ─────────────────────────────────────────────────────────────────────
# In development: http://localhost:5173
# In production: your Vercel URL (no trailing slash)
CLIENT_URL=http://localhost:5173

# ─── Cloudinary (image uploads) ───────────────────────────────────────────────
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret

# ─── Google OAuth 2.0 ────────────────────────────────────────────────────────
# Required for "Continue with Google" sign-in
# Setup: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# NOTE: GOOGLE_CLIENT_SECRET is NOT required — we only verify ID tokens, not exchange auth codes
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── AI Chatbot (Google Gemini) ───────────────────────────────────────────────
# Required for AI-powered responses (free tier available)
# Get key: https://aistudio.google.com/app/apikey
# Without this key: chatbot still works with keyword-based fallback responses
GEMINI_API_KEY=your_gemini_api_key
